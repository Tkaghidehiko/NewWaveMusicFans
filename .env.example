# サイトの公開URL（末尾のスラッシュなし）
#
# canonical・sitemap.xml・robots.txt・OGP画像の絶対URLがすべてここを基準に作られる。
# 独自ドメインが決まったら Vercel の環境変数に設定する。
#
# 未設定でも Vercel なら VERCEL_PROJECT_PRODUCTION_URL に自動フォールバックするため、
# 「とりあえずデプロイして動かす」段階では設定しなくてよい。
NEXT_PUBLIC_SITE_URL=https://example.com

# 検索エンジンにインデックスさせない場合は false にする。
# 記事が仮の状態で公開テストするときや、プレビュー環境で使う。
# 未設定なら true（インデックス許可）扱い。
NEXT_PUBLIC_ALLOW_INDEXING=true
